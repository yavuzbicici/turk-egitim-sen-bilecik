PORT=8787

# SMTP settings (required to actually send email)
SMTP_PORT=587
SMTP_USER=your_user@example.com
SMTP_PASS=your_password
SMTP_FROM="Türk Eğitim-Sen Bilecik <your_user@example.com>"

# Auth token secret (required for admin actions)
AUTH_TOKEN_SECRET=change_me

# Firebase (recommended)
# Create a Firebase project -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste private_key from JSON, keep the \n escapes
FIREBASE_PRIVATE_KEY=

# Cloudinary (duyuru görselleri — isteğe bağlı)
# Gerçek değerleri sadece server/.env dosyasına yazın; bu dosyaya ASLA gerçek secret koymayın.
# CLOUDINARY_API_SECRET = Cloudinary panelindeki "API Secret" (bu dosyada boş bırakın).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# İsterseniz: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Örn: tes-bilecik/announcements
CLOUDINARY_UPLOAD_FOLDER=tes-bilecik/announcements