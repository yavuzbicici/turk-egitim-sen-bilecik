{
  "expo": {
    "name": "Türk Eğitim-Sen Bilecik Şube",
    "slug": "turk-egitim-sen-bilecik",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yavuzbicici.tesbilecik"
    },
    "android": {
      "package": "com.yavuzbicici.tesbilecik",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Duyuru görseli eklemek için fotoğraflarınıza erişmemiz gerekiyor.",
          "cameraPermission": "Duyuru görseli eklemek için kameraya erişmemiz gerekiyor."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0db4d3f-e45d-4bc6-9b88-8657fa5452fb"
      }
    },
    "owner": "tesbilecikmobil"
  }
}
